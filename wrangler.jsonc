{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokemonbattledata",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-07-08",
  // Ed25519 signing needs the Node-compat crypto surface in Workers.
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "LICENSES", "id": "88038110bbeb4f709e4cf614f67acc3d" }
  ],
  // Share cards (functions/api/share/*): the digest record and the 1200x630 PNG
  // a client rendered.  R2 and not KV -- the free KV allowance is 1,000 writes a
  // day for the whole account and the licence and sync endpoints already spend
  // from it, while R2's free tier is 10 GB with 1,000,000 Class A operations a
  // month.
  //
  // Switched on 29 Sep 2026, in the order this file demanded: the bucket was
  // created first and the binding added after it, because this worktree is
  // committed and deployed automatically every few hours and a binding naming a
  // bucket that did not exist yet would have gone live before anyone could
  // create it.  Keep that order for any bucket added here later.
  //
  // Without the binding every share route answers 503 "Sharing is not
  // configured on this server.", exactly as the sync routes do without their
  // namespace (functions/api/sync/index.js:8), and nothing else is affected.
  // The binding NAME must stay the exact property functions/api/share/_lib.js
  // store() reads off env; tests/run-share-endpoints.mjs asserts that pairing,
  // because any other name deploys cleanly and then 503s every share.
  "r2_buckets": [
    { "binding": "SHARES", "bucket_name": "cbd-shares" }
  ]
}
